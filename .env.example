# Server-only. No NEXT_PUBLIC_ prefix, so none of these reach the browser.

# Grading free-text answers. Gemini is tried first.
GEMINI_API_KEY=
# Optional, defaults to gemini-flash-lite-latest.
# GEMINI_MODEL=

# Fallback grader. The free tier allows 50 requests per day for the whole account.
OPENROUTER_API_KEY=
# Optional, overrides lib/ai/models.ts (comma-separated).
# OPENROUTER_MODELS=

# Signs the anonymous learner cookie. Required for history to be stored at all.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it signs every device out and orphans their stored history.
SESSION_SECRET=

# Question storage and practice history.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Rate limiting outside Vercel. How many proxies you control sit in front of the
# app, so the client IP can be read from the right end of x-forwarded-for.
# Unset means clients cannot be identified and the limited routes refuse.
TRUSTED_PROXY_HOPS=

# Local single-user development only. Puts every caller on earth in one bucket,
# so one client can deny the service. Never set this in a deployed environment.
RATE_LIMIT_SHARED_BUCKET=

# How many question sets scripts/build-variations.ts composes per lesson.
# Optional, defaults to 15.
# VARIATIONS=

# Sent as HTTP-Referer / X-Title to OpenRouter (optional).
APP_URL=
APP_NAME=
